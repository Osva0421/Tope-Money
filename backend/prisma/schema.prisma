generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// MODELOS DE TOPE MONEY

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  categories       Category[]
  transactions     Transaction[]
  goals            Goal[]
  creditCards      CreditCard[]
  statementImports StatementImport[]
  statementEntries StatementEntry[]
}

model Category {
  id           String        @id @default(uuid())
  name         String
  type         String // 'EXPENSE' | 'INCOME'
  nature       String // 'ESSENTIAL' | 'DISCRETIONARY' | 'OTHER'
  icon         String?
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  parentId     String?
  parent       Category?     @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryToSubcategory")
  transactions Transaction[]
  keywords     String[]      @default([])
  isDefault    Boolean       @default(false) // true = viene de la plantilla base, no la creó el usuario
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  description String?
  merchant    String
  type        String
  isPlanned   Boolean
  date        DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  categoryAssignedBy String?

  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id])

  statementImportId String?
  statementImport   StatementImport? @relation(fields: [statementImportId], references: [id], onDelete: SetNull)
  statementEntries  StatementEntry[]
  externalReference String?

  @@index([userId, date])
  @@index([creditCardId, date])
  @@index([statementImportId])
}

model Goal {
  id            String    @id @default(uuid())
  name          String
  targetAmount  Decimal   @db.Decimal(14, 2)
  currentAmount Decimal   @default(0) @db.Decimal(14, 2)
  targetDate    DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model CreditCard {
  id             String   @id @default(uuid())
  name           String
  lastFourDigits String?
  creditLimit    Decimal  @db.Decimal(14, 2)
  statementDay   Int
  paymentDueDay  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model StatementImport {
  id             String    @id @default(uuid())
  sourceName     String
  fileName       String?
  format         String    @default("CSV")
  status         String    @default("PROCESSING")
  rowCount       Int       @default(0)
  createdCount   Int       @default(0)
  matchedCount   Int       @default(0)
  duplicateCount Int       @default(0)
  errorCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries             StatementEntry[]
  createdTransactions Transaction[]

  @@index([userId, createdAt])
}

model StatementEntry {
  id                String    @id @default(uuid())
  rowNumber         Int
  date              DateTime?
  merchant          String?
  amount            Float?
  type              String?
  externalReference String?
  fingerprint       String?
  status            String
  confidence        Float?
  errorMessage      String?
  rawData           Json
  createdAt         DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  importId String
  import   StatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([importId, rowNumber])
  @@index([userId, fingerprint])
  @@index([importId, status])
}
